# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_TOKEN=choose-a-long-admin-token
DATABASE=mindful.db

# --- Phone OTP ---
# console = prints the OTP in the server log (development)
# twilio  = real SMS via Twilio   |  msg91 = real SMS via MSG91 (recommended for India / DLT)
SMS_PROVIDER=console
# Show the OTP inside the app response. Use ONLY for local demos. Set to 0 in production.
DEV_SHOW_OTP=1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=

# Sample counsellors and community members for demos. Set to 0 for a real launch.
SEED_DEMO=1
